# 复制成 backend/.env 再填。.env 已在 .gitignore 里，不会进仓库。
# 必填：DeepSeek 的 API Key
DEEPSEEK_API_KEY=
# 可选：默认官方端点；换成学校网关就填网关地址，例如 https://api.chat.csu.edu.cn/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：单次 AI 调用超时秒数
# DEEPSEEK_TIMEOUT=120
# 可选：稿件与材料的落盘目录，默认 backend/data
# WORKBENCH_DATA_DIR=
# 真机联调使用四个演示角色和此口令，建议使用自己的随机口令。
WORKBENCH_DEMO_PASSWORD=
# 可选：启用 MySQL 保存稿件元数据、审核状态和历史。先创建数据库。
# WORKBENCH_MYSQL_URL=mysql://workbench:your-password@127.0.0.1:3306/workbench
